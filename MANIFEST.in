# Source distribution contents. Excludes local state and secrets so a build
# never ships a .env (which holds API keys) or a working database.
include LICENSE
include README.md
include ROADMAP.md
include alembic.ini
include .env.example
recursive-include verialign *.py *.mako
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
exclude .env
global-exclude *.sqlite3
global-exclude *.db
prune tests
prune docs
prune .github
prune scripts
prune .pytest_cache
prune .ruff_cache
